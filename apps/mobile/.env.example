# Copie ce fichier en .env.local (même dossier) et remplis les deux valeurs
# depuis le dashboard Supabase : bouton « Connect » en haut, ou Project Settings > API Keys.
# Ces deux valeurs sont publiques par nature (la sécurité repose sur les règles RLS).
# Ne mets JAMAIS ici la clé « secret » / « service_role » ni le mot de passe de la base.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Forcer le mode démo hors ligne même avec Supabase configuré (tests en local)
# EXPO_PUBLIC_FORCE_DEMO=1
