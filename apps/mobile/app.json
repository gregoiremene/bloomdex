{
  "expo": {
    "name": "WeedApp",
    "slug": "weedapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.weedapp.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.weedapp.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "WeedApp",
      "themeColor": "#0F1A12",
      "backgroundColor": "#0F1A12"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#7BD88F"
        }
      ]
    ],
    "scheme": "weedapp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9b9c347-3861-4e8d-97f1-be85ad488b15"
      }
    }
  }
}
